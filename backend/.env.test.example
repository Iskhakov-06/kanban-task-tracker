# Настройки для запуска тестов локально. Скопируйте в .env.test:  cp .env.test.example .env.test
#
# ВАЖНО: имя базы должно заканчиваться на "_test" — тесты очищают все таблицы,
# при другом имени они откажутся запускаться. База создаётся автоматически.
#
# Пример для MySQL из docker compose (docker compose up -d db) — нужен root, чтобы создать базу:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=task_tracker_test
DB_USER=root
DB_PASSWORD=значение_DB_ROOT_PASSWORD_из_корневого_.env
