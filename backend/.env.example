PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_tracker
DB_USER=tracker_user
DB_PASSWORD=change_me

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

BCRYPT_ROUNDS=12

# SMTP (e.g. Gmail app password, Mailtrap, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Task Tracker <your@gmail.com>"

CLIENT_URL=http://localhost:3000

# apply DB migrations on startup (default: true)
# AUTO_MIGRATE=false
