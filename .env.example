# Copy to .env (never commit it):  cp .env.example .env
# Used by docker-compose.yml

NODE_ENV=development

DB_ROOT_PASSWORD=change_me_root
DB_NAME=task_tracker
# app user: must NOT be "root" (MySQL image refuses it); root has its own password above
DB_USER=tracker_user
DB_PASSWORD=change_me

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# SMTP for email verification / password reset
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Task Tracker <your@gmail.com>"

CLIENT_URL=http://localhost:3000
